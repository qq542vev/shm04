	setup REST help:usage abbr:true -- \
		"Usage: ${2##*/} [command] [options...] [arguments...]"
	msg -- '' 'SHARP AQUOS SH-M04の設定を行う。' ''
	msg -- 'Options:'

	disp    :usage  -h --help    -- 'このヘルプを表示して終了する。'
	disp    VERSION    --version -- 'バージョン情報を表示して終了する。'

	msg -- '' 'Commands:'

	cmd clean        -- 'アプリのキャッシュデータを削除する。'
	cmd notification -- 'アプリの通知を設定する。'
	cmd enable       -- 'アプリを有効化する。'
	cmd disable      -- 'アプリを無効化する。'
	cmd install      -- 'アプリをインストールする。'
	cmd uninstall    -- 'アプリをアンインストールする。'
