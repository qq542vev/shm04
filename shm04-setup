notif_definition() {
	setup notif_REST help:notif_usage abbr:true on:toggle init: -- \
		"Usage: ${2##*/} notification options... app-name"
	msg -- '' 'アプリケーションの通知設定を行う。' ''
	msg -- 'Options:'

	option all    -a +a --{no-}all      pattern:'on | off | toggle | ""' var:'(on | off)' -- 'すべてブロック。'
	option prio   -p +p --{no-}priority pattern:'on | off | toggle | ""' var:'(on | off)' -- '優先通知。'
	option popup  -P +P --{no-}popup    pattern:'on | off | toggle | ""' var:'(on | off)' -- '通知の瞬間表示を許可。'
	option secret -s +s --{no-}secret   pattern:'on | off | toggle | ""' var:'(on | off)' -- 'プライベートな内容を非表示。'
	disp  :notif_usage -h --help -- 'このヘルプを表示して終了する。'
}
