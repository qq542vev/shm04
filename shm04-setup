parse "${@}"
eval "set -- ${REST}"

cmd="${1}"
shift

clean() {
	name="${1}"

	path_check "${name}"
	message "${name} のキャッシュを削除します。"

	message '端末へのマクロ操作を行います。端末を操作しないでください。'
	setting_open "package:${name}"

	if ! point=$(tap_point '//node[@resource-id="android:id/title"][@text="ストレージ"]/@bounds'); then
		message "${name} のストレージ設定を開けません。"
		return 1
	fi

	adb shell input tap ${point}

	if ! point=$(tap_point '//node[@resource-id="com.android.settings:id/button"][@text="キャッシュを消去"]/@bounds'); then
		message "${name} のキャッシュを削除する項目がありません。"
		return 1
	fi

	adb shell input tap ${point}

	if ! point=$(tap_point '//node[@resource-id="android:id/button1"][@text="OK"]/@bounds'); then
		message "${name} のキャッシュ削除の確認ダイアログがありません。"
		return 1
	fi

	adb shell input tap ${point}
}

enable() {
	name="${1}"

	path_check "${name}"
	message "${name} を有効化します。"

	if is_enable "${name}"; then
		message "${name} は既に有効化されています。有効化処理をスキップします。"
		return 0
	fi

	message '端末へのマクロ操作を行います。端末を操作しないでください。'
	setting_open "package:${name}"

	if ! point=$(tap_point '//node[@resource-id="com.android.settings:id/left_button"][@enabled="true"][@text="有効にする"]/@bounds'); then
		message "${name} を有効化できません。"
		return 1
	fi

	adb shell input tap ${point}

	if ! is_enable "${name}"; then
		message 'Failure'
		return 1
	fi
}

disable() {
	name="${1}"

	path_check "${name}"
	message "${name} を無効化します。"

	if ! is_enable "${name}"; then
		message "${name} は既に無効化されています。無効化処理をスキップします。"
		return 1
	fi

	message '端末へのマクロ操作を行います。端末を操作しないでください。'
	setting_open "package:${name}"

	if ! point=$(tap_point '//node[@resource-id="com.android.settings:id/left_button"][@enabled="true"][@text="無効にする"]/@bounds'); then
		message "${name} を無効化できません。"
		return 1
	fi

	adb shell input tap ${point}

	if ! point=$(tap_point '//node[@resource-id="android:id/button1"][@text="アプリを無効にする"]/@bounds'); then
		message "${name} の無効化の確認ダイアログがありません。"
		return 1
	fi

	adb shell input tap ${point}

	if point=$(tap_point '//node[@resource-id="android:id/button1"][@text="OK"]/@bounds'); then
		adb shell input tap ${point}
	fi

	if is_enable "${name}"; then
		message 'Failure'
		return 1
	fi
}

install() {
	name="${1}"

	case "${name}" in
		'http://'* | 'https://'* | 'ftp://'*)
			message "${name} をダウンロードしています。"
			wget -O "${TMPDIR:-/tmp}/${0}-${$}.apk" "${name}"
			name="${TMPDIR:-/tmp}/${0}-${$}.apk"
			;;
	esac

	adb shell pm install "${name}"

	rm -f "${TMPDIR:-/tmp}/${0}-${$}.apk"
}

uninstall() {
	name="${1}"

	path_check "${name}"

	case "$(adb exec-out pm path "${name}")" in
		package:/system/*) is_sucsess shell pm uninstall --user 0 "${name}";;
		*) is_sucsess shell pm uninstall "${name}";;
	esac
}

case "${cmd}" in
	clean) clean "${@}";;
	enable) enable "${@}";;
	disable) disable "${@}";;
	install) install "${@}";;
	uninstall) uninstall "${@}";;
esac
