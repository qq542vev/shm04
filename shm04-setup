set -feu

readonly VERSION=1.0.0

alias adb='adb wait-for-device && adb'

is_enable() {
	adb exec-out pm list package -e | grep -Fqxe "package:${1}"
}

is_sucsess() {
	set -- "$(adb "${@}" 2>&1)"

	if [ "${1}" != 'Success' ]; then
		printf 'adb: %s\n' "${1}" >&2
		return 1
	fi
}

keyevent() {
	while [ 1 -le "${#}" ]; do
		adb shell input keyevent "KEYCODE_${1}"
		sleep 1
		shift
	done
}

message() {
	while [ 1 -le "${#}" ]; do
		printf '%s: %s\n' "${0##*/}" "${1}" >&2
		shift
	done
}

path_check() {
	if [ -z "$(adb exec-out pm path "${1}")" ]; then
		message "${name} が存在しません。"
		return 1
	fi
}

setting_open() {
	keyevent HOME
	adb shell am force-stop com.android.settings
	adb shell am start -a android.settings.APPLICATION_DETAILS_SETTINGS -d "${@}"
	sleep 1
}

tap_point() {
	set -- "${1}" "current-window_${0##*/}-${$}.xml"
	set -- "${1}" "/sdcard/${2}" "${TMPDIR:-/tmp}/${2}"
	adb shell uiautomator dump "${2}" >/dev/null
	adb pull "${2}" "${3}" >/dev/null
	adb shell rm -f -- "${2}"

	xmllint --xpath "${1}" "${3}" 2>/dev/null | awk -F '[^0-9]+' '{ print (($4 - $2) / 2) + $2 " " (($5 - $3) / 2) + $3; exit; } END { exit !NF; }' && status="${?}" || status="${?}"
	rm -f -- "${3}"
	return "${status}"
}

